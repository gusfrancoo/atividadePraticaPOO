<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.projetopraticopoo.controller.HelloController"
      alignment="CENTER" spacing="20.0">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30" />
    </padding>

    <Label text="Cadastro de Doador" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <rowConstraints>
            <RowConstraints valignment="CENTER" />
        </rowConstraints>

        <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoId" promptText="Ex: 1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nome do Doador:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoNome" promptText="Ex: João da Silva" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Telefone:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="campoTelefone" promptText="Ex: 999999999" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="campoEmail" promptText="Ex: joao@email.com" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Cadastrar Doador" onAction="#onCadastrarDoadorClick" maxWidth="200" />

    <VBox spacing="5" alignment="CENTER">
        <Label fx:id="successText" textFill="#00ff00" wrapText="true"/>
        <Label fx:id="erroText" textFill="RED" wrapText="true"/>
    </VBox>

</VBox>
