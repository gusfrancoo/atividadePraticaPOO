<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.projetopraticopoo.controller.DoacaoController"
      alignment="CENTER" spacing="20">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <Label text="Cadastro de Doação" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoId" promptText="Ex: 1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Doador:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoDoador" promptText="Nome do doador" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Entidade:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="campoEntidade" promptText="Nome da entidade" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Item Doador:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="campoItem" promptText="Alimentos, roupas, etc" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Quantidade:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="campoQuantidade" promptText="Ex: 10" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Data da Doação:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <DatePicker fx:id="campoData" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Cadastrar Doação" onAction="#onCadastrarDoacaoClick" minWidth="200"/>

    <Label fx:id="successText" textFill="GREEN"/>
    <Label fx:id="erroText" textFill="RED"/>

</VBox>
