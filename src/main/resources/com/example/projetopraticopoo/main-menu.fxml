<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.projetopraticopoo.controller.MainMenuController"
      alignment="CENTER" spacing="20">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Button text="Cadastrar Doador" onAction="#abrirCadastroDoador" minWidth="200"/>
    <Button text="Cadastrar Entidade" onAction="#abrirCadastroEntidade" minWidth="200"/>
    <Button text="Cadastrar Doação" onAction="#abrirCadastroDoacao" minWidth="200"/>
    <Button text="Listar Doações" onAction="#abrirListagemDoacoes" minWidth="200"/>

</VBox>
